:root{--bg:#070808;--bg2:#0b0d0e;--panel:#111315;--panel2:#17191b;--line:#2b2d2e;--line2:#4b3e25;--ink:#e8e0cf;--muted:#8f918d;--gold:#d1b36b;--gold2:#8a6c32;--red:#a32e26;--red2:#5b1713;--green:#6e8b66;--cyan:#6da6a7;--shadow:0 24px 70px rgba(0,0,0,.42)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 60% -10%,#191b1e 0,#0a0b0c 35%,#050606 100%);color:var(--ink);font-family:Inter,system-ui,sans-serif;min-height:100vh;overflow-x:hidden}button,input,select,textarea{font:inherit}button{cursor:pointer}a{color:inherit}#stars{position:fixed;inset:0;width:100%;height:100%;z-index:-3}.noise{position:fixed;inset:0;z-index:-2;pointer-events:none;opacity:.15;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.18'/%3E%3C/svg%3E")}
body:before{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;background:linear-gradient(rgba(255,255,255,.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.012) 1px,transparent 1px);background-size:56px 56px}
.sidebar{position:fixed;left:0;top:0;bottom:0;width:245px;z-index:40;background:linear-gradient(180deg,rgba(10,11,12,.98),rgba(5,6,7,.98));border-right:1px solid #2e2b24;box-shadow:14px 0 50px rgba(0,0,0,.35);display:flex;flex-direction:column}.side-brand{height:154px;padding:26px 24px;text-decoration:none;border-bottom:1px solid #2c2922;position:relative;background:radial-gradient(circle at 50% 0,rgba(204,170,88,.1),transparent 70%)}.side-brand:after{content:"";position:absolute;inset:8px;border:1px solid rgba(209,179,107,.14);pointer-events:none}.side-brand .eagle{display:block;color:var(--gold);font-size:36px;line-height:1;margin-bottom:7px}.side-brand b{display:block;font:700 24px/1.03 Cinzel,serif;letter-spacing:.08em}.side-brand small{display:block;margin-top:9px;color:#7e7257;font:600 9px/1.2 'Roboto Condensed';letter-spacing:.22em}.side-nav{padding:12px 0}.side-nav button{width:100%;height:46px;display:flex;align-items:center;gap:12px;padding:0 22px;border:0;border-left:2px solid transparent;background:transparent;color:#9b9d98;text-align:left;font:600 12px 'Roboto Condensed';text-transform:uppercase;letter-spacing:.06em}.side-nav button:hover{background:#111313;color:#ddd5c4}.side-nav button.active{background:linear-gradient(90deg,rgba(144,34,28,.34),rgba(144,34,28,.05));border-left-color:#ba3c31;color:#f0dfc0}.side-nav button:first-child{font-size:13px}.side-divider{margin-top:auto;padding:10px 20px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);color:#655d4e;font:700 9px 'Roboto Condensed';letter-spacing:.18em}.side-links{padding:10px 20px;display:grid;gap:8px}.side-links a{font-size:11px;color:#94948e;text-decoration:none}.side-links a:hover{color:var(--gold)}.side-disclaimer{padding:0 20px 18px;margin:0;color:#525652;font-size:9px;line-height:1.5}.shell{margin-left:245px;min-height:100vh}.topbar{height:66px;position:sticky;top:0;z-index:35;display:flex;align-items:center;justify-content:space-between;padding:0 32px;background:rgba(