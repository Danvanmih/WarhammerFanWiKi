mplate-columns:repeat(3,1fr);gap:10px}.spot-card{padding:22px;min-height:190px}.spot-card h3{font-size:20px}.spot-card b,.archive-card>b{position:absolute;bottom:18px;color:#9d875a;font:700 9px 'Roboto Condensed';text-transform:uppercase}.split-home{display:grid;grid-template-columns:1fr 1fr;gap:18px}.era-panel{border:1px solid #2d3031;background:#101214;padding:26px;min-height:170px}.era-panel p{color:#969994;line-height:1.7;font-size:13px}.search{background:#0c0e0f;border:1px solid #333637;color:var(--ink);padding:11px 13px;min-width:260px;outline:none}.search:focus{border-color:#715d35}.category-tabs{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:22px}.chip{border:1px solid #2f3334;background:#0d0f10;color:#858986;padding:8px 11px;font:600 10px 'Roboto Condensed';text-transform:uppercase}.chip.active,.chip:hover{border-color:#765f34;color:var(--gold)}.card-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.archive-card{padding:22px;min-height:250px}.archive-card .sigil{font-size:36px;color:var(--gold);min-height:44px}.archive-card .meta,.character-card .meta,.legion-card .meta{color:#6f746f;font:600 9px 'Roboto Condensed';letter-spacing:.08em;text-transform:uppercase}.archive-card h3{font-size:19px;margin-top:16px}.org-card .sigil{color:#9f8a60}.arsenal-card .sigil{color:#9da09b}.legion-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.legion-card{padding:24px;min-height:220px}.legion-card:before{content:"";position:absolute;left:0;top:0;bottom:0;width:2px;background:#596c58}.legion-card.traitor:before{background:#8e2f2b}.roman{position:absolute;right:18px;top:12px;font:800 62px Cinzel;color:rgba(255,255,255,.035)}.legion-card h3{margin-top:22px}.legion-card>b{display:block;color:#88754f;font:600 10px 'Roboto Condensed';margin-top:16px}.redacted-record{margin-top:14px;height:82px;border:1px dashed #332d2a;display:flex;align-items:center;justify-content:center;gap:40px;color:#584d48}.redacted-record span{font:700 32px Cinzel}.redacted