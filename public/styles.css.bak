end .c-xenos{background:#5f9c8f}.map-legend .c-contested{background:#b8b8ad}.map-side{padding:26px;border-left:0}.map-side h3{font:700 25px Cinzel;text-transform:uppercase;margin:28px 0 10px}.map-side p{color:#8d918d;line-height:1.6;font-size:12px}.record-meta{display:grid;gap:7px;margin:22px 0}.record-meta div{display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid #25282a;padding-bottom:6px}.record-meta span{color:#6f736f;font-size:10px}.record-meta b{font-size:10px;color:#c6bfae}.detail-open{width:100%;border:1px solid #6b5530;background:#17130e;color:#d7c28c;margin-top:12px}.detail-page{padding:34px 5vw 80px}.detail-breadcrumb{display:flex;gap:10px;align-items:center;color:#686c68;font-size:10px;margin-bottom:14px}.detail-breadcrumb button{border:0;background:transparent;color:#9a8454;padding:0}.detail-hero{position:relative;padding:54px 40px;border:1px solid #37342c;background:radial-gradient(circle at 78% 50%,rgba(209,179,107,.11),transparent 26%),linear-gradient(140deg,#151718,#0a0c0d);overflow:hidden}.detail-hero:after{content:attr(data-watermark);position:absolute;right:5%;top:50%;transform:translateY(-50%);font:800 150px Cinzel;color:rgba(255,255,255,.028)}.detail-kicker{color:var(--gold);font:700 10px 'Roboto Condensed';letter-spacing:.18em}.detail-hero h1{font-size:clamp(40px,6vw,78px);line-height:.95;margin:10px 0 18px;max-width:920px}.detail-sub{max-width:900px;color:#a3a39b;line-height:1.7}.detail-meta{display:flex;flex-wrap:wrap;gap:7px;margin-top:20px}.detail-meta span{padding:7px 10px;border:1px solid #353839;background:#0d0f10;color:#8d918d;font:600 9px 'Roboto Condensed';text-transform:uppercase}.detail-grid{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:14px;margin-top:14px}.detail-block{border:1px solid #2e3132;background:#0f1112;padding:26px}.detail-block h2{font:700 19px Cinzel;text-transform:uppercase;margin:0 0 18px}.detail-block p,.detail-block li{color:#9ca09b;line-height:1.7;font-size:13px}.history-item{position:relative;padding:13px 0 13px 20px;border-bottom:1px solid #242728;color:#9ea29d;line-height:1.7;font-size:13px}.history-item:before{content:"";position:absolute;left:0;top:20px;width:6px;height:6px;background:#9c8146;transform:rotate(45deg)}.relation-list,.source-list{display:grid;gap:7px}.relation-link,.source-list a{display:flex;justify-content:space-between;text-decoration:none;border:1px solid #2f3233;background:#0b0d0e;padding:10px 12px;color:#aaa99f;font-size:11px}.relation-link:hover,.source-list a:hover{border-color:#6d5a36;color:var(--gold)}.source-note{font-size:10px!important;color:#626663!important}.search-overlay,.assistant-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.68);opacity:0;pointer-events:none;transition:.2s;z-index:80}.search-overlay.open,.assistant-backdrop.open{opacity:1;pointer-events:auto}.search-modal{width:min(780px,92vw);max-height:78vh;margin:8vh auto;background:#0d0f10;border:1px solid #4a4130;box-shadow:0 40px 100px rgba(0,0,0,.6);overflow:hidden}.search-head{display:grid;grid-template-columns:1fr 46px;border-bottom:1px solid #303334}.search-head input{background:#090b0c;border:0;color:var(--ink);padding:17px 20px;outline:none}.search-head button{border:0;border-left:1px solid #303334;background:#111315;color:#aaa;font-size:22px}.global-results{max-height:65vh;overflow:auto;padding:8px}.global-result{width:100%;display:flex;justify-content:space-between;align-items:center;text-align:left;border:0;border-bottom:1px solid #222526;background:transparent;color:var(--ink);padding:13px 14px}.global-result:hover{background:#151718}.global-result b{display:block}.global-result small{display:block;margin-top:3px;color:#646864}.assistant-panel{position:fixed;z-index:90;right:0;top:0;bottom:0;width:min(470px,100%);background:#0b0d0e;border-left:1px solid #4a3f2d;transform:translateX(102%);transition:.28s;display:flex;flex-direction:column;box-shadow:-40px 0 90px rgba(0,0,0,.5)}.assistant-panel.open{transform:none}.assistant-head{display:flex;justify-content:space-between;align-items:center;padding:22px;border-bottom:1px solid #2d3031}.assistant-head h2{font:700 26px Cinzel;margin:0}.assistant-head button{width:34px;height:34px;border:1px solid #333637;background:#0d0f10;color:#aaa;font-size:20px}.assistant-status{padding:9px 22px;border-bottom:1px solid #292c2d;color:#6f746f;font:600 9px 'Roboto Condensed';text-transform:uppercase}.assistant-status i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#6b8b66;box-shadow:0 0 9px #6b8b66;margin-right:6px}.chat{flex:1;overflow:auto;padding:18px;display:flex;flex-direction:column;gap:10px}.msg{max-width:88%;padding:13px 14px;border:1px solid #2f3233;background:#141617}.msg.user{align-self:flex-end;background:#211b11;border-color:#4d3f24}.msg b{font:700 9px 'Roboto Condensed';color:var(--gold);letter-spacing:.11em}.msg p{margin:7px 0 0;white-space:pre-wrap;line-height:1.55;color:#c1c0b8;font-size:13px}.msg .sources{display:grid;gap:4px;margin-top:10px}.msg .sources a{color:#a78d55;font-size:10px}.quick-asks{display:flex;gap:6px;padding:0 16px 10px;overflow:auto}.quick-asks button{white-space:nowrap;border:1px solid #2f3334;background:#111314;color:#868a86;padding:7px 9px;font-size:10px}.ask-form{display:grid;grid-template-columns:1fr 48px;gap:7px;padding:14px 16px;border-top:1px solid #292c2d}.ask-form textarea{resize:none;background:#07090a;border:1px solid #303334;color:var(--ink);padding:10px;outline:none}.ask-form button{border:1px solid #75592d;background:#a82d25;color:#fff;font-size:18px}.assistant-note{padding:0 16px 14px;color:#565b57;font-size:9px}footer{min-height:58px;border-top:1px solid #272a2b;display:flex;align-items:center;justify-content:space-between;padding:0 4.5vw;color:#545955;font:600 9px 'Roboto Condensed';letter-spacing:.08em}
@media(max-width:1200px){.stats-ribbon{grid-template-columns:repeat(4,1fr)}.module-grid{grid-template-columns:repeat(2,1fr)}.card-grid{grid-template-columns:repeat(3,1fr)}.character-grid,.legion-grid{grid-template-columns:repeat(2,1fr)}.hero-seal{display:none}.map-layout{grid-template-columns:1fr}.map-side{border-top:1px solid #303334}.detail-grid{grid-template-columns:1fr}.detail-aside{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}}
@media(max-width:900px){.sidebar{transform:translateX(-100%);transition:.25s}.menu-open .sidebar{transform:none}.shell{margin-left:0}.mobile-menu{display:block}.topbar{padding:0 16px}.crumb span{display:none}.stats-ribbon{grid-template-columns:repeat(2,1fr)}.spotlight-grid{grid-template-columns:repeat(2,1fr)}.card-grid{grid-template-columns:repeat(2,1fr)}.split-home{grid-template-columns:1fr}.map-section{padding-left:16px;padding-right:16px}}
@media(max-width:620px){.topbar{height:58px}.search-btn span,.search-btn kbd,.assistant-pill span{display:none}.hero{min-height:560px}.hero-copy{padding:72px 20px}.hero h1{font-size:54px}.lead{font-size:14px}.content-section,.detail-page{padding-left:18px;padding-right:18px}.module-grid,.spotlight-grid,.card-grid,.character-grid,.legion-grid{grid-template-columns:1fr}.section-heading{align-items:flex-start;flex-direction:column}.search{width:100%;min-width:0}.map-toolbar{flex-direction:column}.map-search-wrap{min-width:0;width:100%}.map-toolbar select{width:100%}.galaxy-viewport{height:560px}.detail-hero{padding:34px 20px}.detail-hero h1{font-size:38px}.detail-hero:after{font-size:90px}.detail-aside{grid-template-columns:1fr}.timeline:before{left:12px}.timeline article{grid-template-columns:1fr;gap:6px;padding-left:30px}.timeline time{text-align:left;padding:0}.timeline-card:before{left:-23px}.hero-actions{flex-direction:column;align-items:flex-start}.stats-ribbon button{padding:16px 10px}}

/* ====== 2.1 Dense dossier / illustration pass ====== */
.illustrated{position:relative;overflow:hidden;padding-top:128px!important}.illustrated .card-art{position:absolute;inset:0 0 auto 0;height:145px;background-position:center;background-size:cover;filter:saturate(.8) contrast(1.08);opacity:.78;transition:.35s}.illustrated .card-art:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,9,10,.05),#0d0f10 92%)}.illustrated:hover .card-art{transform:scale(1.035);opacity:.95}.illustrated>.sigil,.illustrated>.roman,.illustrated>.type-badge{position:relative;z-index:2}.archive-card.illustrated h3,.character-card.illustrated h3,.legion-card.illustrated h3{position:relative;z-index:2}.archive-card.illustrated p,.character-card.illustrated p,.legion-card.illustrated p{position:relative;z-index:2}
.detail-cinematic{min-height:430px;position:relative;border:1px solid #4a402d;background-image:var(--hero);background-position:center;background-size:cover;overflow:hidden;box-shadow:0 30px 90px rgba(0,0,0,.28)}.detail-cinematic:after{content:attr(data-watermark);position:absolute;right:5%;bottom:-18px;font:800 170px Cinzel;color:rgba(255,255,255,.05);text-shadow:0 0 40px rgba(0,0,0,.65)}.detail-cinematic-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,6,7,.97) 0%,rgba(5,6,7,.8) 38%,rgba(5,6,7,.12) 73%),linear-gradient(0deg,rgba(5,6,7,.88),transparent 48%)}.detail-cinematic-copy{position:absolute;z-index:2;left:42px;bottom:42px;max-width:760px}.detail-cinematic-copy h1{font:700 clamp(44px,6vw,82px) Cinzel;letter-spacing:-.035em;line-height:.94;margin:9px 0 15px;text-transform:uppercase;text-shadow:0 3px 20px #000}.detail-cinematic-copy>p{color:#c3bcad;max-width:690px;line-height:1.65;font-size:14px}.detail-tabs{position:sticky;top:64px;z-index:19;display:flex;gap:0;overflow:auto;border:1px solid #303233;border-top:0;background:rgba(10,12,13,.94);backdrop-filter:blur(10px);margin-bottom:14px}.detail-tabs a{padding:12px 18px;color:#888c88;text-decoration:none;border-right:1px solid #292c2d;font:600 10px 'Roboto Condensed';letter-spacing:.1em;text-transform:uppercase;white-space:nowrap}.detail-tabs a:hover{color:var(--gold);background:#141414}.intro-block{display:grid;grid-template-columns:minmax(0,1fr) 130px;gap:28px;align-items:center}.intro-block h2{font-size:26px}.intro-copy{font-size:16px!important;color:#d2cbbb!important}.dossier-seal{width:110px;height:110px;border:1px solid #6f5d38;border-radius:50%;display:grid;place-items:center;font:700 42px Cinzel;color:#b89a58;box-shadow:inset 0 0 34px rgba(191,153,76,.08),0 0 50px rgba(0,0,0,.3);justify-self:end}.prose-block p{font-size:14px!important;line-height:1.9!important;color:#aaa99f!important}.lore-section:nth-child(odd){background:radial-gradient(circle at 95% 5%,rgba(194,157,77,.045),transparent 34%),#0f1112}.history-stack{display:grid;gap:2px}.fact-list{columns:2;column-gap:34px;margin:0;padding-left:18px}.fact-list li{break-inside:avoid;margin:0 0 9px;padding-right:14px}.block-head{display:flex;justify-content:space-between;gap:24px;align-items:end;margin-bottom:16px}.block-head small{color:#5f645f;font-size:9px;max-width:240px;text-align:right}.event-strip{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.event-strip button{text-align:left;border:1px solid #303334;background:linear-gradient(145deg,#151718,#0b0d0e);padding:14px;color:#bdb7a8;min-height:125px}.event-strip button:hover{border-color:#705b36;background:#181713}.event-strip small{display:block;color:#9a8050;font:700 9px 'Roboto Condensed';letter-spacing:.1em}.event-strip b{display:block;font:700 15px Cinzel;margin:6px 0}.event-strip span{display:block;color:#737873;font-size:10px;line-height:1.5}.related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.related-card{position:relative;overflow:hidden;text-align:left;min-height:180px;border:1px solid #303334;background:#0b0d0e;color:#c5bfaf;padding:76px 15px 14px}.related-card:before{content:"";position:absolute;inset:0 0 auto;height:95px;background:linear-gradient(180deg,rgba(0,0,0,.05),#0b0d0e),var(--art) center/cover;opacity:.65}.related-card>*{position:relative;z-index:1}.related-card>span{font:700 8px 'Roboto Condensed';text-transform:uppercase;color:#8f7548}.related-card h4{font:700 14px Cinzel;margin:5px 0 8px}.related-card p{font-size:10px!important;line-height:1.45!important;color:#777b77!important;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.related-card b{font-size:9px;color:#b69a5b}.related-card:hover{border-color:#766039;transform:translateY(-1px)}.gallery-block{overflow:hidden}.detail-gallery{display:grid;grid-template-columns:2fr 1fr 1fr;gap:8px}.detail-gallery figure{margin:0;position:relative;min-height:190px;border:1px solid #333637;overflow:hidden;background:#090b0c}.detail-gallery figure:first-child{grid-row:span 2;min-height:390px}.detail-gallery img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover;filter:saturate(.82) contrast(1.07);transition:.35s}.detail-gallery figure:hover img{transform:scale(1.025);filter:saturate(1) contrast(1.05)}.detail-gallery figcaption{position:absolute;left:0;right:0;bottom:0;padding:24px 12px 10px;background:linear-gradient(transparent,rgba(0,0,0,.88));color:#c9c2b2;font:600 9px 'Roboto Condensed';letter-spacing:.06em}.reading-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.reading-grid article{border:1px solid #2e3132;background:#0b0d0e;padding:14px;display:grid;grid-template-columns:34px 1fr;gap:2px 10px;align-items:center}.reading-grid span{grid-row:1/3;color:#8f7445;font:700 11px Cinzel}.reading-grid b{font:700 13px Cinzel}.reading-grid small{color:#676b67;font-size:9px}.dossier{position:sticky;top:118px}.dossier-row{display:grid;grid-template-columns:1fr 1.3fr;gap:12px;padding:9px 0;border-bottom:1px solid #272a2b}.dossier-row span{color:#666a66;font-size:9px;text-transform:uppercase}.dossier-row b{color:#c5bead;font-size:10px;text-align:right}.detail-aside .relation-list{max-height:460px;overflow:auto}.detail-main>.detail-block{scroll-margin-top:122px}.detail-aside>.detail-block{scroll-margin-top:122px}
@media(max-width:1100px){.related-grid{grid-template-columns:repeat(2,1fr)}.detail-gallery{grid-template-columns:1fr 1fr}.detail-gallery figure:first-child{grid-column:span 2;grid-row:auto;min-height:310px}.dossier{position:relative;top:auto}}
@media(max-width:700px){.detail-cinematic{min-height:380px}.detail-cinematic-copy{left:20px;right:20px;bottom:26px}.detail-cinematic-copy h1{font-size:38px}.detail-cinematic-shade{background:linear-gradient(0deg,rgba(4,5,6,.96) 0%,rgba(4,5,6,.56) 68%,rgba(4,5,6,.22))}.detail-tabs{top:58px}.intro-block{grid-template-columns:1fr}.dossier-seal{display:none}.fact-list{columns:1}.event-strip,.related-grid,.reading-grid{grid-template-columns:1fr}.detail-gallery{grid-template-columns:1fr}.detail-gallery figure:first-child{grid-column:auto;min-height:260px}.detail-gallery figure{min-height:220px}.illustrated{padding-top:118px!important}}
.hero{background-image:linear-gradient(90deg,rgba(6,7,8,.96) 0%,rgba(6,7,8,.78) 46%,rgba(6,7,8,.3) 78%,rgba(6,7,8,.72) 100%),linear-gradient(0deg,rgba(6,7,8,.92),transparent 58%),url('/assets/imperium-city.jpg');background-size:cover;background-position:center;box-shadow:inset 0 -120px 120px rgba(0,0,0,.72)}
.hero-grid{opacity:.22}.hero-rift{opacity:.22}.galaxy-disc{background-image:radial-gradient(circle at 50% 50%,rgba(224,199,124,.18),transparent 12%),linear-gradient(rgba(3,4,5,.2),rgba(3,4,5,.2)),url('/assets/galaxy-map.jpg');background-size:cover;background-position:center;opacity:.72;filter:saturate(.9) contrast(1.12)}

/* ===== PRODUCT POLISH / OCT 2026 ===== */
:root{--cursor-x:50vw;--cursor-y:50vh}
body:after{content:"";position:fixed;inset:0;pointer-events:none;z-index:9999;background:radial-gradient(360px circle at var(--cursor-x) var(--cursor-y),rgba(211,174,88,.035),transparent 70%);mix-blend-mode:screen}
.reveal{opacity:0;transform:translateY(12px);transition:opacity .55s ease,transform .55s ease}.reveal.revealed{opacity:1;transform:none}
.module-card,.archive-card,.character-card,.legion-card,.related-card,.spot-card{transform-style:preserve-3d;transform:perspective(900px) rotateX(var(--rx,0)) rotateY(var(--ry,0));will-change:transform}.module-card:hover,.spot-card:hover,.archive-card:hover,.character-card:hover,.legion-card:hover,.related-card:hover{transform:perspective(900px) translateY(-2px) rotateX(var(--rx,0)) rotateY(var(--ry,0))}.module-card:before,.archive-card:after,.character-card:after,.legion-card:after,.spot-card:before{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(240px circle at var(--mx,50%) var(--my,50%),rgba(220,182,92,.08),transparent 70%);opacity:0;transition:.2s}.module-card:hover:before,.archive-card:hover:after,.character-card:hover:after,.legion-card:hover:after,.spot-card:hover:before{opacity:1}

.map-reference{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:14px 16px;margin:-8px 0 10px;border:1px solid #3b3529;background:linear-gradient(90deg,rgba(121,91,37,.09),rgba(10,12,13,.92))}.map-reference>div{display:flex;align-items:center;gap:13px}.map-reference-mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid #685632;color:#d0ab5b;font-size:22px}.map-reference b{font:700 10px 'Roboto Condensed';letter-spacing:.16em;color:#d6bc7f}.map-reference p{margin:4px 0 0;max-width:820px;color:#727873;font-size:10px;line-height:1.55}.map-reference a{white-space:nowrap;text-decoration:none;border:1px solid #5c4c2f;padding:10px 12px;color:#b99a57;font:700 9px 'Roboto Condensed';text-transform:uppercase;letter-spacing:.08em}.map-reference a:hover{background:#17140f;color:#eed392}
.map-modebar{display:flex;align-items:center;justify-content:space-between;gap:18px;margin:0 0 10px;padding:8px;border:1px solid #2f3233;background:#0c0e0f}.era-switch{display:flex;gap:4px}.era-switch button{min-width:132px;border:1px solid #2f3233;background:#101213;color:#777d78;padding:8px 12px;text-align:left}.era-switch button small{display:block;font:700 7px 'Roboto Condensed';letter-spacing:.2em}.era-switch button b{font:700 11px Cinzel}.era-switch button.active{border-color:#7f632f;background:linear-gradient(180deg,#201a10,#101112);color:#e0c278;box-shadow:inset 0 -2px #a22f27}.layer-switches{display:flex;flex-wrap:wrap;gap:4px 12px;justify-content:flex-end}.layer-switches label{font:600 9px 'Roboto Condensed';color:#777c78;text-transform:uppercase;letter-spacing:.05em}.layer-switches input{accent-color:#a12d26;vertical-align:middle}

.galaxy-viewport{background:#020405;box-shadow:inset 0 0 120px #000;isolation:isolate}.galaxy-stage{background:#030405}.galaxy-disc{inset:0!important;width:auto!important;height:auto!important;border-radius:0!important;background-image:linear-gradient(rgba(2,3,4,.06),rgba(2,3,4,.16)),url('/assets/galaxy-atlas.webp')!important;background-size:cover!important;background-position:center!important;opacity:.9!important;filter:saturate(.95) contrast(1.08)!important;transform:translate(var(--px,0),var(--py,0)) scale(1.018);transition:transform .18s ease-out}.galaxy-stage:before{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;background-image:linear-gradient(rgba(205,178,105,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(205,178,105,.06) 1px,transparent 1px);background-size:60px 60px;mask-image:radial-gradient(circle,#000 32%,transparent 88%);opacity:.26}.galaxy-stage:after{content:"GALACTIC NORTH  ↑";position:absolute;left:22px;top:18px;z-index:8;color:#8a7650;font:700 9px 'Roboto Condensed';letter-spacing:.16em;pointer-events:none}
.map-rings{z-index:3!important;opacity:.34}.segmentum{z-index:5!important;text-shadow:0 2px 6px #000,0 0 14px #000!important;letter-spacing:.22em!important}.map-point{z-index:12!important}.map-point i{transition:.2s}.map-point:before{content:attr(data-tip);position:absolute;left:14px;bottom:18px;width:max-content;max-width:220px;padding:5px 7px;background:rgba(5,6,7,.94);border:1px solid #51452f;color:#d5ccb9;font:600 8px 'Roboto Condensed';letter-spacing:.05em;opacity:0;transform:translateY(4px);pointer-events:none;transition:.16s;white-space:nowrap}.map-point:hover:before{opacity:1;transform:none}.map-point.major i{width:12px!important;height:12px!important;box-shadow:0 0 0 5px rgba(212,176,86,.08),0 0 18px currentColor;animation:mapPulse 2.4s ease-in-out infinite}.map-point.highlight i{animation:targetPulse .8s ease-out infinite alternate}.era-30k .map-point[data-affiliation="tyranids"],.era-30k .map-point[data-affiliation="tau"]{opacity:.05!important;pointer-events:none}.era-30k .great-rift,.era-30k [data-incursion-area="tyranids"],.era-30k [data-incursion-area="tau"]{display:none!important}@keyframes mapPulse{50%{box-shadow:0 0 0 9px rgba(212,176,86,0),0 0 26px currentColor}}@keyframes targetPulse{to{transform:scale(1.35)}}
.incursion{position:absolute;z-index:4;pointer-events:none;filter:blur(2px);opacity:.18;transition:.3s}.incursion.hidden{opacity:0}.inc-tyranids{right:-5%;bottom:-8%;width:44%;height:48%;background:radial-gradient(ellipse at 60% 60%,#9230a6 0 18%,transparent 68%);clip-path:polygon(25% 0,100% 12%,85% 100%,0 76%);animation:incursionBreath 7s ease-in-out infinite}.inc-orks{left:8%;bottom:18%;width:29%;height:32%;background:radial-gradient(ellipse,#6f8a31,transparent 68%);clip-path:polygon(18% 0,100% 27%,72% 100%,0 63%)}.inc-necrons{right:9%;top:20%;width:27%;height:30%;background:radial-gradient(ellipse,#28a877,transparent 67%);clip-path:polygon(45% 0,100% 42%,70% 100%,0 70%,10% 20%)}.inc-tau{right:1%;bottom:27%;width:19%;height:24%;background:radial-gradient(ellipse,#2c89c7,transparent 65%)}@keyframes incursionBreath{50%{opacity:.27;transform:scale(1.025)}}
.route-layer{position:absolute;inset:0;z-index:9;pointer-events:none;opacity:0;transition:.3s}.route-layer.visible{opacity:.86}.route{fill:none;stroke-width:2;stroke-dasharray:9 7;filter:drop-shadow(0 0 4px currentColor);animation:routeMove 2.5s linear infinite}.route.loyal{stroke:#75a7c9}.route.traitor{stroke:#b34338}@keyframes routeMove{to{stroke-dashoffset:-32}}
.map-hud{position:absolute;z-index:18;left:12px;bottom:46px;display:flex;gap:16px;pointer-events:none;color:#8f805d;font:700 8px 'Roboto Condensed';letter-spacing:.13em;text-shadow:0 1px 4px #000}.map-scan{position:absolute;z-index:16;left:0;right:0;height:1px;top:0;background:linear-gradient(90deg,transparent,rgba(213,177,91,.55),transparent);box-shadow:0 0 16px rgba(213,177,91,.2);pointer-events:none;animation:mapScan 7s linear infinite}@keyframes mapScan{0%{top:2%;opacity:0}10%{opacity:.35}90%{opacity:.2}100%{top:96%;opacity:0}}
.map-confidence{margin-top:12px;border-top:1px solid #2c3031;padding-top:12px;display:flex;justify-content:space-between;gap:10px}.map-confidence span,.map-related>span{color:#626762;font:700 8px 'Roboto Condensed';text-transform:uppercase;letter-spacing:.08em}.map-confidence b{font-size:9px;color:#b9a16b;text-align:right}.map-source-mini{margin-top:13px;padding:12px;border:1px solid #342f24;background:#0a0c0d}.map-source-mini b{color:#c0a66c;font:700 9px Cinzel}.map-source-mini p{font-size:9px!important;line-height:1.55!important}.map-source-mini a{color:#a98b50;font-size:9px}.map-related{display:grid;gap:5px;margin-top:12px}.map-related button{border:1px solid #2b2f30;background:#0d0f10;color:#9c9d96;padding:7px 8px;text-align:left;font-size:9px}.map-related button:hover{border-color:#695633;color:#d4bb80}

.detail-actions{display:flex;align-items:center;gap:8px;margin:-7px 0 14px;padding:8px 10px;border:1px solid #2d3031;background:#0a0c0d}.detail-actions button{border:1px solid #373a39;background:#111314;color:#8c908b;padding:7px 10px;font:700 8px 'Roboto Condensed';text-transform:uppercase;letter-spacing:.06em}.detail-actions button:hover,.detail-actions button.active{color:#d5b972;border-color:#735d36}.detail-actions span{margin-left:auto;color:#555b56;font:600 8px 'Roboto Condensed';text-transform:uppercase}.media-figure figcaption{display:grid;grid-template-columns:1fr auto;gap:2px 10px;align-items:end}.media-figure figcaption b{font-weight:600}.media-figure figcaption small{color:#77756e;font-size:8px}.media-figure figcaption a{grid-row:1/3;grid-column:2;color:#cfad62;text-decoration:none;font-size:8px;align-self:center}.media-figure.media-error:before{content:"REMOTE ASSET OFFLINE";position:absolute;z-index:2;right:8px;top:8px;background:#581d19;color:#e0b1a3;padding:4px 6px;font:700 7px 'Roboto Condensed';letter-spacing:.09em}
.media-lightbox{position:fixed;z-index:10000;inset:0;background:rgba(0,0,0,.88);backdrop-filter:blur(8px);display:grid;place-items:center;padding:50px;opacity:0;pointer-events:none;transition:.22s}.media-lightbox.open{opacity:1;pointer-events:auto}.media-lightbox figure{margin:0;max-width:min(1400px,92vw);max-height:88vh;border:1px solid #665332;background:#080a0b;box-shadow:0 40px 120px #000;display:grid}.media-lightbox img{max-width:100%;max-height:78vh;object-fit:contain}.media-lightbox figcaption{padding:12px 14px;color:#aaa294;font-size:10px;white-space:pre-line}.lightbox-close{position:absolute;right:28px;top:22px;width:42px;height:42px;border:1px solid #4b4336;background:#101213;color:#ddd1b6;font-size:24px}.toast{position:fixed;z-index:10020;left:50%;bottom:28px;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:#12100d;border:1px solid #756039;color:#dbc58d;padding:10px 16px;font:700 9px 'Roboto Condensed';text-transform:uppercase;letter-spacing:.08em;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}
.reading-progress{position:fixed;z-index:70;left:245px;right:0;top:0;height:2px;pointer-events:none;opacity:0}.reading-progress.active{opacity:1}.reading-progress i{display:block;height:100%;width:var(--progress,0);background:linear-gradient(90deg,#7f241f,#d4b25e);box-shadow:0 0 10px #b99242}

@media(max-width:900px){.map-reference,.map-modebar{align-items:stretch;flex-direction:column}.map-reference a{align-self:flex-start}.layer-switches{justify-content:flex-start}.reading-progress{left:0}.detail-actions{overflow:auto}.detail-actions span{white-space:nowrap}.map-hud{bottom:58px}}
@media(max-width:620px){.era-switch{width:100%}.era-switch button{flex:1;min-width:0}.media-lightbox{padding:16px}.map-reference>div{align-items:flex-start}.map-reference-mark{flex:none}.detail-actions span{display:none}}
.side-personal{border-top:1px solid #1f2223}.side-personal .side-divider{margin-top:0}.side-personal #sidePersonalList{padding:8px 12px 14px;display:grid;gap:4px;max-height:220px;overflow:auto}.side-personal small{color:#5f5a50;font:700 7px 'Roboto Condensed';letter-spacing:.14em;margin:5px 5px 1px}.side-personal button{border:0;border-left:1px solid #332f28;background:transparent;color:#7f837f;padding:5px 6px;display:grid;grid-template-columns:16px 1fr;gap:4px;text-align:left;font-size:9px}.side-personal button i{color:#a99058;font-style:normal}.side-personal button:hover{background:#101212;color:#cfbea0}.side-personal em{padding:4px 6px;color:#464b47;font-size:8px;font-style:normal}.sourced-media{outline:1px solid rgba(123,160,120,.25);outline-offset:-2px}.sourced-media:after{content:"EXTERNAL SOURCE";position:absolute;right:8px;top:8px;z-index:3;background:rgba(11,28,18,.88);border:1px solid #49644c;color:#9fbea2;padding:4px 6px;font:700 7px 'Roboto Condensed';letter-spacing:.08em}
.active-page{animation:pageIn .36s ease both}@keyframes pageIn{from{opacity:.25;transform:translateY(5px)}to{opacity:1;transform:none}}
.hero{background-size:cover;animation:heroDrift 28s ease-in-out infinite alternate}@keyframes heroDrift{from{background-position:48% 50%}to{background-position:53% 48%}}
.side-brand .eagle{animation:aquilaGlow 4.5s ease-in-out infinite}@keyframes aquilaGlow{50%{filter:drop-shadow(0 0 13px rgba(213,176,88,.45));transform:translateY(-1px)}}
.topbar:after{content:"";position:absolute;left:0;bottom:-1px;width:18%;height:1px;background:linear-gradient(90deg,transparent,#9d7d39,transparent);animation:dataSweep 8s linear infinite}@keyframes dataSweep{from{left:-20%}to{left:105%}}
.detail-cinematic:before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(255,255,255,.012) 0 1px,transparent 1px 4px);mix-blend-mode:soft-light}.detail-cinematic{background-attachment:local}.detail-cinematic-copy{animation:dossierTitle .55s ease both}@keyframes dossierTitle{from{opacity:0;transform:translateX(-14px)}to{opacity:1;transform:none}}
.map-reference-actions{display:flex;align-items:center;gap:7px}.reference-preview{position:relative}.reference-preview summary{list-style:none;cursor:pointer;white-space:nowrap;border:1px solid #42392a;padding:10px 12px;color:#867452;font:700 9px 'Roboto Condensed';text-transform:uppercase}.reference-preview summary::-webkit-details-marker{display:none}.reference-preview[open] summary{color:#d1b56f;border-color:#745d36}.reference-preview>div{position:absolute;right:0;top:calc(100% + 8px);z-index:45;width:min(620px,72vw);padding:8px;border:1px solid #5b4930;background:#080a0b;box-shadow:0 24px 70px #000}.reference-preview img{display:block;width:100%;max-height:330px;object-fit:cover;background:#111}.reference-preview small{display:block;padding:7px 4px 2px;color:#747770;font-size:8px;line-height:1.45}@media(max-width:900px){.map-reference-actions{align-self:flex-start;flex-wrap:wrap}.reference-preview>div{left:0;right:auto;width:min(88vw,620px)}}

/* ===== v4.0 ASTARTES CODEX: chapters, worlds and richer visual language ===== */
.chapter-toolbar,.world-toolbar{display:flex;gap:10px;align-items:center;padding:12px 14px;margin:0 0 18px;border:1px solid #2d302f;background:linear-gradient(180deg,rgba(18,20,20,.88),rgba(8,9,9,.92));position:sticky;top:68px;z-index:8;backdrop-filter:blur(14px)}
.chapter-toolbar select,.world-toolbar select{background:#090b0b;color:#c9c4b7;border:1px solid #343938;padding:10px 12px;min-width:220px;outline:none}.chapter-toolbar span,.world-toolbar span{margin-left:auto;color:#7f817d;font:600 11px 'Roboto Condensed';letter-spacing:.12em;text-transform:uppercase}
.gene-lineage{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin:0 0 14px}.gene-lineage button{min-height:82px;text-align:left;color:#c8c4b8;border:1px solid #282d2c;background:linear-gradient(180deg,rgba(18,20,20,.9),rgba(7,8,8,.95));padding:14px;position:relative;overflow:hidden}.gene-lineage button:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(194,157,78,.09),transparent 45%),radial-gradient(circle at 100% 0,rgba(194,157,78,.12),transparent 38%);opacity:0;transition:.25s}.gene-lineage button:hover{border-color:#735d31;transform:translateY(-2px)}.gene-lineage button:hover:before{opacity:1}.gene-lineage span{display:inline-grid;place-items:center;width:30px;height:30px;border:1px solid #665530;color:#c7a65a;font-family:Cinzel,serif;margin-bottom:7px}.gene-lineage b{display:block;font:700 13px 'Roboto Condensed';text-transform:uppercase;letter-spacing:.06em}.gene-lineage small{display:block;margin-top:4px;color:#666c69;font-size:9px;text-transform:uppercase;letter-spacing:.12em}
.chapter-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.chapter-card{position:relative;min-height:390px;border:1px solid #2b2f2e;background:#0b0d0e;color:#ddd8ca;text-align:left;padding:0;overflow:hidden;isolation:isolate;transform:perspective(900px) rotateX(var(--rx,0)) rotateY(var(--ry,0));transition:border-color .25s,transform .25s,box-shadow .25s}.chapter-card:hover{border-color:#776238;box-shadow:0 16px 50px rgba(0,0,0,.35),inset 0 0 35px rgba(202,166,81,.04)}.chapter-card:after{content:"";position:absolute;left:-50%;top:0;width:45%;height:1px;background:linear-gradient(90deg,transparent,#d2ad5c,transparent);animation:archiveSweep 8s linear infinite;opacity:.5}.chapter-card .card-art{height:172px;background-size:cover;background-position:center 24%;filter:saturate(.75) contrast(1.05);transition:transform .5s,filter .4s}.chapter-card:hover .card-art{transform:scale(1.025);filter:saturate(.95) contrast(1.08)}.chapter-card-copy{padding:54px 20px 20px;position:relative}.chapter-card h3{font:700 25px Cinzel,serif;margin:6px 0 10px;text-transform:uppercase}.chapter-card p{color:#8f938f;line-height:1.55;font-size:13px;min-height:61px}.chapter-card .meta{color:#907c51;font:600 10px 'Roboto Condensed';letter-spacing:.09em;text-transform:uppercase}.chapter-card-data{display:flex;gap:8px;flex-wrap:wrap;margin:15px 0}.chapter-card-data span{border:1px solid #2c302f;background:#101212;padding:7px 9px;color:#777d79;font-size:10px}.chapter-card-copy>b{font:700 10px 'Roboto Condensed';letter-spacing:.12em;text-transform:uppercase;color:#c6a450}
.chapter-crest{position:absolute;left:18px;top:142px;width:67px;height:67px;background:linear-gradient(135deg,var(--c1),var(--c1) 49%,var(--c2) 51%,var(--c2));border:3px solid #0c0d0e;outline:1px solid #69562e;display:grid;place-items:center;box-shadow:0 10px 20px rgba(0,0,0,.5);z-index:3;clip-path:polygon(50% 0,92% 18%,88% 72%,50% 100%,12% 72%,8% 18%)}.chapter-crest:after{content:"";position:absolute;inset:8px;border:1px solid rgba(255,255,255,.32);clip-path:inherit}.chapter-crest b{font:800 18px Cinzel,serif;color:#f1ead9;text-shadow:0 2px 5px #000;z-index:2}.chapter-crest i{position:absolute;inset:0;background:radial-gradient(circle at 35% 25%,rgba(255,255,255,.16),transparent 40%)}
.chapter-lineage-block{display:grid!important;grid-template-columns:1fr 140px;gap:24px;align-items:center;position:relative}.chapter-heraldry{width:120px;height:138px;margin:auto;background:linear-gradient(135deg,var(--c1),var(--c1) 49%,var(--c2) 51%,var(--c2));clip-path:polygon(50% 0,92% 16%,88% 72%,50% 100%,12% 72%,8% 16%);display:grid;place-items:center;filter:drop-shadow(0 14px 18px #000)}.chapter-heraldry:after{content:"";position:absolute;width:92px;height:108px;border:1px solid rgba(255,255,255,.28);clip-path:inherit}.chapter-heraldry b{font:700 40px Cinzel;color:#f1ead9;text-shadow:0 3px 7px #000}.chapter-specs{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #292d2c}.chapter-specs span{padding:16px;border-right:1px solid #292d2c}.chapter-specs span:last-child{border-right:0}.chapter-specs small{display:block;color:#6e736f;text-transform:uppercase;font:600 9px 'Roboto Condensed';letter-spacing:.14em}.chapter-specs b{display:block;margin-top:5px;color:#c7c1b1;font:600 13px 'Roboto Condensed'}
.successor-block>p{color:#888e89;line-height:1.65;max-width:850px}.successor-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:16px}.successor-strip button{display:grid;grid-template-columns:44px 1fr;gap:10px;align-items:center;text-align:left;background:#0c0e0e;border:1px solid #292d2c;color:#c9c4b7;padding:10px}.successor-strip button:hover{border-color:#705d35;background:#121313}.successor-strip i{width:38px;height:44px;background:linear-gradient(135deg,var(--c1),var(--c1) 48%,var(--c2) 52%);clip-path:polygon(50% 0,95% 20%,88% 75%,50% 100%,12% 75%,5% 20%)}.successor-strip b{display:block;font:600 12px 'Roboto Condensed';text-transform:uppercase}.successor-strip small{display:block;color:#646a67;font-size:9px;margin-top:3px}
.world-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.world-card{background:#0b0d0e;border:1px solid #292d2c;color:#d8d3c6;text-align:left;padding:0;min-height:330px;overflow:hidden;position:relative;transform:perspective(900px) rotateX(var(--rx,0)) rotateY(var(--ry,0));transition:.25s}.world-card:hover{border-color:#66562f;transform:perspective(900px) rotateX(var(--rx,0)) rotateY(var(--ry,0)) translateY(-3px)}.world-card .card-art{height:160px;background-size:cover;background-position:center;filter:saturate(.7) contrast(1.08);transition:.45s}.world-card:hover .card-art{filter:saturate(1) contrast(1.08);transform:scale(1.03)}.world-card-copy{padding:17px}.world-card h3{font:700 22px Cinzel;margin:5px 0 8px;text-transform:uppercase}.world-card p{color:#8b908c;font-size:12px;line-height:1.55;min-height:74px}.world-card .meta{font:600 9px 'Roboto Condensed';letter-spacing:.12em;color:#987f4c;text-transform:uppercase}.world-card-copy>div{border-top:1px solid #272b2a;padding-top:10px}.world-card-copy small{display:block;color:#5f6461;text-transform:uppercase;font-size:8px;letter-spacing:.13em}.world-card-copy b{font:600 11px 'Roboto Condensed';color:#aca89d}
@keyframes archiveSweep{0%{left:-50%}55%,100%{left:125%}}
/* Make existing lists feel more like an image-led codex, while still allowing remote exact art to replace fallbacks. */
.archive-card .card-art,.character-card .card-art,.legion-card .card-art{background-position:center 22%;background-size:cover;transition:transform .45s ease,filter .35s ease}.archive-card:hover .card-art,.character-card:hover .card-art,.legion-card:hover .card-art{transform:scale(1.025);filter:saturate(1.02) contrast(1.06)}
.detail-cinematic:after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(5,6,6,.92),rgba(5,6,6,.25) 52%,rgba(5,6,6,.54)),linear-gradient(0deg,rgba(5,6,6,.88),transparent 45%);z-index:0}.detail-cinematic-copy{z-index:2}.detail-cinematic{background-position:center 24%;transition:background-image .35s ease}.detail-cinematic[data-media-source]:before{content:"EXTERNAL ARCHIVE IMAGE · SOURCE IN GALLERY";position:absolute;right:18px;bottom:15px;z-index:3;color:#83755a;font:600 8px 'Roboto Condensed';letter-spacing:.16em}
/* Tiny ambient ornaments */
.content-section:before{content:"";position:fixed;pointer-events:none;z-index:-1;left:var(--cursor-x,-200px);top:var(--cursor-y,-200px);width:360px;height:360px;transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(187,150,69,.035),transparent 68%)}
.side-nav button[data-route="chapters"]:before{content:"";position:absolute;left:0;top:18%;bottom:18%;width:1px;background:#826a36;opacity:.45}.side-nav button[data-route="worlds"]:before{content:"";position:absolute;left:0;top:18%;bottom:18%;width:1px;background:#557b83;opacity:.35}
@media(max-width:1250px){.chapter-grid{grid-template-columns:repeat(2,1fr)}.world-grid{grid-template-columns:repeat(3,1fr)}.gene-lineage{grid-template-columns:repeat(3,1fr)}}
@media(max-width:800px){.chapter-toolbar,.world-toolbar{position:static;flex-direction:column;align-items:stretch}.chapter-toolbar select,.world-toolbar select{min-width:0;width:100%}.chapter-toolbar span,.world-toolbar span{margin:0}.chapter-grid,.world-grid{grid-template-columns:1fr}.gene-lineage{grid-template-columns:repeat(2,1fr)}.chapter-lineage-block{grid-template-columns:1fr}.chapter-specs,.successor-strip{grid-template-columns:1fr}.chapter-heraldry{grid-row:1;margin-right:0}}

.stats-ribbon{grid-template-columns:repeat(8,1fr)}
.sidebar{overflow-y:auto;overflow-x:hidden}
@media(max-width:1200px){.stats-ribbon{grid-template-columns:repeat(4,1fr)}}
@media(max-width:900px){.stats-ribbon{grid-template-columns:repeat(2,1fr)}}
.org-card .card-art,.arsenal-card .card-art{height:128px;margin:-22px -22px 18px;background-size:cover;background-position:center;filter:saturate(.7) contrast(1.08)}
.org-card .sigil,.arsenal-card .sigil{position:absolute;top:108px;left:20px;width:46px;height:46px;border:2px solid #0d0f10;outline:1px solid #65542f;background:#101212;display:grid;place-items:center;font-size:24px;z-index:2}.org-card .meta,.arsenal-card .meta{display:block;margin-top:8px}.org-card h3,.arsenal-card h3{margin-top:10px}.org-card,.arsenal-card{padding-bottom:42px}
.timeline-card.illustrated{padding:0;display:grid;grid-template-columns:210px 1fr;overflow:hidden;min-height:150px}.timeline-thumb{min-height:150px;background-size:cover;background-position:center;filter:saturate(.72) contrast(1.06);position:relative}.timeline-thumb:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent 55%,#101214)}.timeline-copy{padding:22px 24px}.timeline-card:hover .timeline-thumb{filter:saturate(1) contrast(1.08)}
@media(max-width:700px){.timeline-card.illustrated{grid-template-columns:1fr}.timeline-thumb{min-height:135px}.timeline-thumb:after{background:linear-gradient(0deg,#101214,transparent 55%)}}

/* === CODEX V5 visual polish === */
:root{--codex-gold:#c9a85b;--codex-red:#7e1d18;--codex-cyan:#607f88}
body:after{content:"";position:fixed;inset:0;pointer-events:none;z-index:9998;background:radial-gradient(circle at 50% 45%,transparent 48%,rgba(0,0,0,.27) 100%);mix-blend-mode:multiply}
.page.active-page>.content-section{animation:pageMaterialize .42s cubic-bezier(.2,.7,.2,1) both}@keyframes pageMaterialize{from{opacity:.15;transform:translateY(8px);filter:blur(2px)}to{opacity:1;transform:none;filter:none}}
.side-nav button{position:relative;overflow:hidden}.side-nav button:after{content:"";position:absolute;left:0;bottom:0;height:1px;width:100%;background:linear-gradient(90deg,transparent,#b6944d,transparent);transform:translateX(-110%);transition:transform .35s}.side-nav button:hover:after,.side-nav button.active:after{transform:translateX(0)}
.archive-card,.character-card,.legion-card,.chapter-card,.world-card,.org-card,.arsenal-card{isolation:isolate}.archive-card:before,.character-card:before,.legion-card:before,.chapter-card:before,.world-card:before{content:"";position:absolute;inset:-40%;z-index:5;pointer-events:none;background:linear-gradient(105deg,transparent 42%,rgba(231,203,128,.08) 49%,transparent 56%);transform:translateX(-80%) rotate(4deg);transition:transform .75s ease}.archive-card:hover:before,.character-card:hover:before,.legion-card:hover:before,.chapter-card:hover:before,.world-card:hover:before{transform:translateX(80%) rotate(4deg)}
.detail-tabs{position:sticky;top:55px;z-index:18;backdrop-filter:blur(14px);box-shadow:0 12px 30px rgba(0,0,0,.28)}
.detail-cinematic{box-shadow:0 35px 100px rgba(0,0,0,.42),inset 0 0 0 1px rgba(202,167,88,.08)}
.detail-cinematic-shade:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent 0 48%,rgba(206,177,103,.08) 49%,transparent 50%);transform:translateX(-100%);animation:heroScanner 10s linear infinite;opacity:.55}@keyframes heroScanner{0%,18%{transform:translateX(-100%)}75%,100%{transform:translateX(110%)}}
.detail-cinematic-shade:after{content:"";position:absolute;inset:0;background-image:radial-gradient(circle at 20% 30%,rgba(222,190,105,.08) 0 1px,transparent 1.7px),radial-gradient(circle at 76% 62%,rgba(255,255,255,.06) 0 1px,transparent 1.7px);background-size:73px 71px,91px 87px;animation:dustDrift 28s linear infinite;opacity:.36}@keyframes dustDrift{to{background-position:73px 142px,-91px -174px}}
.detail-cinematic-copy h1{filter:drop-shadow(0 0 18px rgba(202,166,81,.09))}
.lineage-flow-block{overflow:hidden}.lineage-flow{display:flex;gap:7px;overflow:auto;padding:3px 2px 9px;scrollbar-width:thin}.lineage-flow button{position:relative;display:grid;grid-template-columns:52px minmax(118px,1fr) 18px;gap:10px;align-items:center;min-width:205px;background:linear-gradient(145deg,#111414,#0a0c0d);border:1px solid #2d312f;color:#cbc6b8;padding:9px;text-align:left;transition:.24s}.lineage-flow button:hover{border-color:#7c6637;background:#151716;transform:translateY(-2px);box-shadow:0 10px 25px rgba(0,0,0,.28)}.lineage-flow button>i{width:52px;height:52px;border:1px solid #52472e;background-position:center;background-size:cover;filter:saturate(.76) contrast(1.05);box-shadow:inset 0 0 20px #000}.lineage-flow button span small{display:block;color:#7c7156;font:600 8px 'Roboto Condensed';letter-spacing:.14em;margin-bottom:4px}.lineage-flow button span b{display:block;font:700 12px 'Roboto Condensed';text-transform:uppercase;line-height:1.15}.lineage-flow button em{font-style:normal;color:#917640;font-size:18px;animation:lineagePulse 2.4s ease-in-out infinite}@keyframes lineagePulse{50%{opacity:.35;transform:translateX(3px)}}
.media-figure{position:relative;overflow:hidden}.media-source-ribbon{position:absolute;left:0;top:0;z-index:3;padding:7px 9px;background:rgba(8,9,9,.86);border-right:1px solid #68562f;border-bottom:1px solid #68562f;color:#c29d4e;font:600 8px 'Roboto Condensed';letter-spacing:.12em;pointer-events:none}.media-figure img{transition:transform .5s ease,filter .4s}.media-figure:hover img{transform:scale(1.018);filter:saturate(1.06) contrast(1.03)}.exact-media{border-color:#51452d!important}.exact-media figcaption a{color:#b9974d!important}
.chapter-heraldry{animation:crestFloat 5s ease-in-out infinite}@keyframes crestFloat{50%{transform:translateY(-5px);filter:drop-shadow(0 18px 24px rgba(0,0,0,.8))}}
.chapter-card .chapter-crest{transition:transform .35s,filter .35s}.chapter-card:hover .chapter-crest{transform:translateY(-4px) rotate(-1deg);filter:brightness(1.08)}
.stats-ribbon strong{font-variant-numeric:tabular-nums;text-shadow:0 0 20px rgba(202,166,81,.12)}
.map-point.critical i{animation:criticalPulse 1.6s ease-out infinite}@keyframes criticalPulse{0%{box-shadow:0 0 0 0 rgba(208,65,54,.45),0 0 10px currentColor}80%,100%{box-shadow:0 0 0 13px rgba(208,65,54,0),0 0 18px currentColor}}
.relation-link{position:relative;overflow:hidden}.relation-link:after{content:"";position:absolute;left:0;top:0;bottom:0;width:2px;background:#b89448;transform:scaleY(0);transform-origin:bottom;transition:.25s}.relation-link:hover:after{transform:scaleY(1)}
@media(max-width:850px){.detail-tabs{top:0}.lineage-flow button{min-width:185px}}
.card-source-badge{position:absolute;right:8px;top:8px;z-index:7;background:rgba(5,6,6,.82);border:1px solid #4e452f;color:#9f8a5b;padding:4px 6px;font:600 7px 'Roboto Condensed';letter-spacing:.11em;pointer-events:none}
